# 同事远程连接环境配置
# 连接到 192.168.1.6 上的后端服务

# 后端API地址
VITE_API_BASE_URL=http://192.168.1.6:8000

# API前缀
VITE_API_PREFIX=/api

# 认证服务地址
VITE_AUTH_BASE_URL=http://192.168.1.6:8000

# WebSocket地址
VITE_WS_BASE_URL=http://192.168.1.6:8000

# Continue接口地址（核算服务）
VITE_CONTINUE_API_BASE_URL=http://192.168.1.6:8000
