# 本地开发环境配置
# 此文件优先级高于 .env

# 后端API地址
VITE_API_BASE_URL=http://localhost:8000

# API前缀
VITE_API_PREFIX=/api/v1

# 认证服务地址
VITE_AUTH_BASE_URL=http://localhost:8000

# WebSocket地址
VITE_WS_BASE_URL=http://localhost:8000

# Continue接口地址（核算服务）
# 本地开发：使用本地服务器
VITE_CONTINUE_API_BASE_URL=http://localhost:8000

# 语音识别接口域名（Speech Services）
# 通过 API Gateway 访问，无需直接配置
# VITE_SPEECH_RECOGNITION_BASE_URL=http://192.168.1.143:8888

# 语音合成接口域名（CosyVoice TTS）TODO: 需要替换为实际的 TTS 服务地址
VITE_TTS_BASE_URL=http://192.168.1.154:8000
