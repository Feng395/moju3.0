# ============================================
# 本地环境配置示例
# 复制此文件为 .env.local 并根据实际情况修改
# .env.local 文件不会被提交到 Git
# ============================================

# API 基础 URL
VITE_API_BASE_URL=http://192.168.1.143:8000

# API 前缀
VITE_API_PREFIX=/api

# 认证服务基础 URL
VITE_AUTH_BASE_URL=http://192.168.1.143:8000

# WebSocket 基础 URL
VITE_WS_BASE_URL=http://192.168.1.143:8000

# Continue 接口专用 URL（核算服务）
# 注意：后端已统一使用 8000 端口
VITE_CONTINUE_API_BASE_URL=http://192.168.1.143:8000
