# ========================================
# 同事远程连接环境配置
# 连接到 192.168.1.6 上的 Docker 服务
# ========================================

# ========== 应用配置 ==========
APP_NAME=模具成本核算系统-远程测试
APP_VERSION=2.1.0
PORT=8000


# 数据库配置（远程 192.168.1.6）
DB_HOST=192.168.1.6
DB_PORT=5432
DB_NAME=mold_cost
DB_USER=postgres
DB_PASSWORD=root

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Redis配置
REDIS_URL=redis://192.168.1.6:6379

# RabbitMQ配置
RABBITMQ_HOST=192.168.1.6
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# MinIO配置
MINIO_ENDPOINT=192.168.1.6:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=mold-cost
MINIO_BUCKET_FILES=mold-cost
MINIO_REGION=us-east-1

# MinIO 外部访问地址（用于生成预签名URL）
# 同事的浏览器需要能直接访问此地址
MINIO_EXTERNAL_ENDPOINT=192.168.1.6:9000

# JWT配置
JWT_SECRET_KEY=your-secret-key-change-in-production-2024
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# 文件上传配置
MAX_FILE_SIZE_MB=1000
ALLOWED_FILE_EXTENSIONS=.dwg,.prt

# 外部NC Agent配置
NC_AGENT_URL=http://192.168.0.65:8001
NC_AGENT_TIMEOUT=60

# ODA File Converter 配置
# 同事需要根据自己的安装路径修改
ODA_FILE_CONVERTER_PATH=D:\\workspace\\ODA\\ODAFileConverter.exe

# MCP服务配置
CAD_PARSER_MCP_URL=http://192.168.1.6:8101
FEATURE_RECOGNITION_MCP_URL=http://192.168.1.6:8102
NC_CONNECTOR_MCP_URL=http://192.168.1.6:8103
PRICING_SERVER_MCP_URL=http://192.168.1.6:8105
REPORT_GENERATOR_MCP_URL=http://192.168.1.6:8107

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs
ENABLE_JSON_LOG=false
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5     

# 监控配置
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# 开发模式
DEBUG=true
RELOAD=true

# ============================================
# LLM 配置（可选）
# ============================================

OPENAI_API_KEY=sk-dummy
OPENAI_MODEL=Qwen3-30B-A3B-Instruct
OPENAI_BASE_URL=http://192.168.0.22:8000/v1

# ============================================
# Agent 配置
# ============================================

USE_LLM=true
USE_LLM_FOR_QUERY_DETAILS=true
USE_CHAT_HISTORY=true
MAX_HISTORY_MESSAGES=10

# ============================================
# 性能配置
# ============================================

LLM_TIMEOUT=300
API_TIMEOUT=60
LLM_TEMPERATURE=0
MAX_RETRIES=3

# ============================================
# 参数验证配置
# ============================================

SUPPORTED_MATERIALS=P20,718,NAK80,S136,H13,2738
MIN_THICKNESS=1
MAX_THICKNESS=500
MIN_WIRE_LENGTH=0
MAX_WIRE_LENGTH=10000
