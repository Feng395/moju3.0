# ========================================
# 日志系统配置示例
# ========================================

# 日志级别
# 可选值: DEBUG, INFO, WARNING, ERROR, CRITICAL
# 开发环境建议: DEBUG 或 INFO
# 生产环境建议: INFO 或 WARNING
LOG_LEVEL=INFO

# 日志目录
# 所有日志文件将保存在此目录下
LOG_DIR=logs

# 启用 JSON 格式日志（可选）
# true: 启用 JSON 格式日志（便于日志收集系统解析）
# false: 不启用（默认）
ENABLE_JSON_LOG=false

# 启用模块分类日志（推荐）
# true: 按模块分类保存日志（api_gateway.log, workers.log 等）
# false: 只保存总日志（app.log）
ENABLE_MODULE_LOGS=true

# ========================================
# 日志文件说明
# ========================================
# 
# 启用模块分类后，将生成以下日志文件：
# 
# logs/
# ├── app.log              # 总日志（所有模块）
# ├── error.log            # 错误日志（ERROR及以上）
# ├── api_gateway.log      # API Gateway 日志
# ├── workers.log          # Workers 日志
# ├── agents.log           # Agents 日志
# ├── mcp_services.log     # MCP 服务日志
# ├── scripts.log          # Scripts 日志
# └── shared.log           # Shared 模块日志
#
# 每个日志文件都会自动轮转：
# - 单文件最大: 10MB
# - 保留备份: 7 个
# - 命名规则: app.log.1, app.log.2, ...
#
# ========================================
# 使用建议
# ========================================
#
# 开发环境：
# LOG_LEVEL=DEBUG
# ENABLE_MODULE_LOGS=true
#
# 测试环境：
# LOG_LEVEL=INFO
# ENABLE_MODULE_LOGS=true
#
# 生产环境：
# LOG_LEVEL=INFO
# ENABLE_MODULE_LOGS=true
# ENABLE_JSON_LOG=true  # 如果使用日志收集系统
#
