# InteractionAgent V2 配置示例
# 复制此文件为 .env 并填写实际值

# ============================================
# LLM 配置（可选）
# ============================================

# OpenAI API Key（启用 AI 提示时需要）
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI 模型选择（可选，默认 gpt-4o-mini）
# 选项: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# OpenAI API Base URL（可选，使用代理时需要）
# OPENAI_API_BASE=https://your-proxy.com/v1

# ============================================
# Agent 配置
# ============================================

# 是否启用 LLM（true/false）
# 生产环境建议设置为 false
USE_LLM=false

# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO

# ============================================
# 性能配置
# ============================================

# LLM 请求超时（秒）
LLM_TIMEOUT=30

# LLM 温度（0-1，越低越确定）
LLM_TEMPERATURE=0

# 最大重试次数
MAX_RETRIES=3

# ============================================
# 参数验证配置
# ============================================

# 支持的材质列表（逗号分隔）
SUPPORTED_MATERIALS=P20,718,NAK80,S136,H13,2738

# 厚度范围（mm）
MIN_THICKNESS=1
MAX_THICKNESS=500

# 线割长度范围（mm）
MIN_WIRE_LENGTH=0
MAX_WIRE_LENGTH=10000

# ============================================
# 缓存配置（可选）
# ============================================

# 是否启用提示缓存
ENABLE_PROMPT_CACHE=true

# 缓存过期时间（秒）
CACHE_TTL=3600

# ============================================
# 监控配置（可选）
# ============================================

# 是否启用性能监控
ENABLE_MONITORING=true

# 是否记录详细日志
ENABLE_DETAILED_LOGGING=false

# ============================================
# 开发配置
# ============================================

# 开发模式（启用更多调试信息）
DEV_MODE=false

# 是否启用工作流可视化
ENABLE_VISUALIZATION=false
