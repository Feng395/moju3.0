# ========================================
# 集成开发环境配置
# 使用远程服务器上的服务
# ========================================

# ========== 应用配置 ==========
APP_NAME=模具成本核算系统-集成开发
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO
PORT=8000

# ========== 数据库配置 ==========
# 远程 PostgreSQL
DB_HOST=192.168.1.54
DB_PORT=5432
DB_NAME=mold_cost_db
DB_USER=root
DB_PASSWORD=yunzai123
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ========== JWT认证配置 ==========
JWT_SECRET_KEY=your-production-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ========== Redis配置 ==========
# 远程 Redis
REDIS_HOST=192.168.0.41
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# ========== RabbitMQ配置 ==========
# 远程 RabbitMQ
RABBITMQ_HOST=192.168.0.41
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=Admin@123
RABBITMQ_VHOST=/

# ========== MinIO配置 ==========
# 远程 MinIO
MINIO_ENDPOINT=192.168.0.41:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=files
MINIO_REGION=us-east-1

# ========== LLM配置 ==========
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
USE_LLM=true

# ========== NC加工时间服务配置 ==========
# 远程 NC 服务
NC_SERVICE_URL=http://192.168.0.65:8001
NC_SERVICE_TIMEOUT=86400

# ========== CAD拆图配置 ==========
# ODA文件转换器路径（根据服务器实际路径配置）
ODA_FILE_CONVERTER_PATH=

# ========== 文件上传配置 ==========
MAX_UPLOAD_SIZE=100
ALLOWED_EXTENSIONS=dwg,dxf,step,stp,igs,iges,prt

# ========== 安全配置 ==========
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION=1800

# ========== CORS配置 ==========
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://192.168.0.41:5173
CORS_ALLOW_CREDENTIALS=true

# ========== 日志配置 ==========
ENABLE_JSON_LOG=true
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ========== 性能配置 ==========
WORKER_PROCESSES=4
WORKER_TIMEOUT=300
KEEP_ALIVE=5

# ========== 功能开关 ==========
ENABLE_WEBSOCKET=true
ENABLE_CHAT_HISTORY=true
ENABLE_REVIEW_SYSTEM=true
ENABLE_METRICS=true

# ========== MCP服务配置 ==========
CAD_PRICE_SEARCH_MCP_URL=http://localhost:8200
CAD_PRICE_SEARCH_MCP_HOST=0.0.0.0
CAD_PRICE_SEARCH_MCP_PORT=8200

# ========== 并发控制配置 ==========
FEATURE_RECOGNITION_MAX_CONCURRENT=10
MCP_CLIENT_POOL_SIZE=10
MCP_CLIENT_MAX_RETRIES=3
MCP_CLIENT_TIMEOUT=300

# ========== 批处理配置 ==========
PRICING_BATCH_SIZE=20
EXPORT_WORKERS=4
MINIO_DOWNLOAD_WORKERS=4
MINIO_UPLOAD_WORKERS=6
MINIO_UPLOAD_PART_SIZE=5242880
