# 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# 数据库配置
DB_HOST=192.168.0.123
DB_PORT=5432
DB_NAME=mold_cost_db
DB_USER=root
DB_PASSWORD=yunzai123

# Redis配置
REDIS_URL=redis://localhost:6379

# RabbitMQ配置
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=Admin@123
RABBITMQ_QUEUE_JOB_PROCESSING=job_processing
RABBITMQ_QUEUE_DLX=job_processing_dlx

# MinIO配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_BUCKET=files
MINIO_BUCKET_FILES=files

# MinIO外部访问地址（可选）
# 用于生成预签名URL，适用于内网用localhost，外网用IP的场景
# 如果不设置，则使用 MINIO_ENDPOINT
# 示例: MINIO_EXTERNAL_ENDPOINT=192.168.0.41:9000
MINIO_EXTERNAL_ENDPOINT=

# JWT配置
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# 文件上传配置
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_EXTENSIONS=.dwg,.prt

# 外部NC Agent配置
NC_AGENT_URL=http://192.168.0.65:8001
NC_AGENT_TIMEOUT=86400

# 外部API配置
FEATURE_REPROCESS_API_URL=http://192.168.1.51:8300/api/features/reprocess
PRICING_RECALCULATE_API_URL=http://192.168.1.51:8300/api/pricing/recalculate
WEIGHT_PRICE_API_URL=http://192.168.0.20:8201/api/price_wg

# MCP服务配置
CAD_PARSER_MCP_URL=http://localhost:8101
CAD_PRICE_SEARCH_MCP_URL=http://localhost:8200
FEATURE_RECOGNITION_MCP_URL=http://localhost:8102
NC_CONNECTOR_MCP_URL=http://localhost:8103
PRICING_SERVER_MCP_URL=http://localhost:8105
REPORT_GENERATOR_MCP_URL=http://localhost:8107

# 日志配置
LOG_LEVEL=INFO                    # 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_DIR=logs                      # 日志文件目录
ENABLE_JSON_LOG=false             # 是否启用 JSON 格式日志（生产环境建议 true）
LOG_MAX_BYTES=10485760            # 单个日志文件最大大小（字节，默认 10MB）
LOG_BACKUP_COUNT=5                # 保留的日志文件数量

# 监控配置
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# 开发模式
DEBUG=true
RELOAD=true

# ============================================
# LLM 配置（可选）
# ============================================

# OpenAI API Key（启用 AI 提示时需要）
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI 模型选择（可选，默认 gpt-4o-mini）
OPENAI_MODEL=gpt-4o-mini

# OpenAI API Base URL（可选，使用代理或本地模型时需要）
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# Agent 配置
# ============================================

# 是否启用 LLM（true/false）
USE_LLM=false

# 是否在查询详情时使用 LLM 格式化（true/false）
USE_LLM_FOR_QUERY_DETAILS=false

# 是否启用聊天历史记忆（true/false）
# 启用后，LLM 可以记住之前的对话上下文
USE_CHAT_HISTORY=true

# 最大历史消息数量（条）
# 限制传递给 LLM 的历史消息数量，避免 token 超限
MAX_HISTORY_MESSAGES=10

# ============================================
# 性能配置
# ============================================

# LLM 请求超时（秒）
LLM_TIMEOUT=300

# 外部API请求超时（秒）
API_TIMEOUT=60

# 最大重试次数
MAX_RETRIES=3
