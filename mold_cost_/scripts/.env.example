# CAD服务配置示例
# 复制此文件为 .env 并填入实际配置

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cad_database
DB_USER=postgres
DB_PASSWORD=your_password

# ==================== ODA转换器配置 ====================
ODA_FILE_CONVERTER_PATH=C:/Program Files/ODA/ODAFileConverter_title 24.12.0/ODAFileConverter.exe

# ==================== MinIO配置 ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cad-files
MINIO_SECURE=false

# ==================== API服务配置 ====================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_WORKERS=1
API_DEBUG=false

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=feature_recognition.log

# ==================== 板料线功能配置 ====================
# 是否启用板料线自动添加功能（默认启用）
ENABLE_MATERIAL_LINES=true

# ==================== 导出性能配置 ====================
# 并发导出子图的工作线程数（默认5）
EXPORT_WORKERS=5
