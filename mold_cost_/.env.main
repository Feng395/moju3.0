# 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# 数据库配置
DB_HOST=192.168.1.54
DB_PORT=5432
DB_NAME=mold_cost_db
DB_USER=root
DB_PASSWORD=yunzai123

# Redis配置
REDIS_URL=redis://192.168.0.41:6379/0

# RabbitMQ配置
RABBITMQ_HOST=192.168.0.41
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=Admin@123
RABBITMQ_QUEUE_JOB_PROCESSING=job_processing
RABBITMQ_QUEUE_DLX=job_processing_dlx

# 队列并发配置
# job_processing 队列并发数（任务编排）
# 服务器配置：6核16GB
# 推荐值：3-4（每个任务约占用0.5核2GB）
# 瓶颈：NC Agent 并发能力、MinIO 带宽
JOB_PROCESSING_CONCURRENCY=3

# pricing_recalculate 队列并发数（价格重算）
# 推荐值：4-5（每个任务约占用0.25核0.5GB）
# 瓶颈：数据库连接池
PRICING_RECALCULATE_CONCURRENCY=4

# MinIO配置
MINIO_ENDPOINT=192.168.0.41:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_USE_HTTPS=false
MINIO_BUCKET_FILES=files
MINIO_REGION=us-east-1
# MinIO 并行下载配置
MINIO_DOWNLOAD_WORKERS=5  # 并发下载数，建议 5-10
# MinIO 上传性能配置
MINIO_UPLOAD_PART_SIZE=10485760  # 分片大小（字节），默认 10MB，可调整为 5MB-50MB
MINIO_UPLOAD_WORKERS=8            # 并发上传数，建议 5-10，根据网络带宽调整

# 子图导出并发数配置
# 根据 CPU 核心数和子图数量调整：
EXPORT_WORKERS=5  # 导出并发数，默认 8（推荐用于100+子图）

# 价格计算批次大小配置
PRICING_BATCH_SIZE=50  # 每批处理的子图数量，默认50（避免连接池耗尽）

# ============================================================================
# 特征识别并发控制配置
# ============================================================================
# Agent层并发数（同时处理多少个子图）
# 建议值：
#   - 小规模（<50个子图）：10-15
#   - 中等规模（50-200个子图）：20-30
#   - 大规模（>200个子图）：30-50
FEATURE_RECOGNITION_MAX_CONCURRENT=25

# MCP Client 连接池配置
# 连接池大小应该 >= 并发数 + 10%余量
MCP_CLIENT_POOL_SIZE=30
MCP_CLIENT_MAX_RETRIES=3
MCP_CLIENT_TIMEOUT=600  # 单个请求超时时间（秒），默认10分钟（特征识别可能需要更长时间）

# 自适应并发控制（实验性功能）
# 根据系统负载自动调整并发数
FEATURE_RECOGNITION_ADAPTIVE_CONCURRENCY=false
FEATURE_RECOGNITION_MIN_CONCURRENT=10
FEATURE_RECOGNITION_MAX_CONCURRENT_LIMIT=50

# 性能监控配置
FEATURE_RECOGNITION_SLOW_THRESHOLD=30000  # 慢查询阈值（毫秒），30秒（特征识别通常需要较长时间）
FEATURE_RECOGNITION_LOG_PERFORMANCE=true  # 是否记录性能日志

# CAD 拆图服务配置
ODA_FILE_CONVERTER_PATH=C:\\anzhuang\\ODAFileConverter\\ODAFileConverter.exe

# CAD 拆图服务端口配置
SERVER_HOST=localhost
SERVER_PORT=6009
SERVER_RELOAD=false
SERVER_WORKERS=1

# JWT配置
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# 外部NC Agent配置
NC_AGENT_URL=http://192.168.0.111:8001
NC_AGENT_TIMEOUT=86400  # 24小时 = 24 * 60 * 60 = 86400秒

# MCP服务配置（统一服务）
CAD_PRICE_SEARCH_MCP_URL=http://localhost:8200
CAD_PRICE_SEARCH_MCP_HOST=0.0.0.0
CAD_PRICE_SEARCH_MCP_PORT=8200

# API Gateway配置
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8300

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json

# 监控配置
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# 开发模式
DEBUG=true
RELOAD=true

# 禁用自动重试（推荐）
ENABLE_MESSAGE_RETRY=false
